# Copy to .env (never commit .env) or set these in your host's dashboard.

# Port to listen on
PORT=3000

# Folder for the SQLite database. Use a persistent disk in production.
DATA_DIR=./data

# Comma-separated usernames that get moderation access
ADMIN_USERNAMES=sakshar

# Enables the AI autopsy. Leave empty to hide the feature.
ANTHROPIC_API_KEY=

# Set to 0 to start with an empty graveyard instead of demo ideas
SEED=1

# Set to 1 behind a reverse proxy so rate limits see real client IPs
TRUST_PROXY=0

# Set to 1 to mark cookies Secure (automatic when NODE_ENV=production)
COOKIE_SECURE=0
